// Cloudflare Worker that serves the built web app as static assets (design D5).
// Having this file turns off Wrangler's automatic project detection, which does not
// understand pnpm workspaces. The name must match the Worker created in the dashboard.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mind-racer",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Branches other than main deploy with `npx wrangler preview`, which needs this block (it can stay empty).
  "previews": {}
}
